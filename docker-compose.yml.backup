services:
  db:
    image: pgvector/pgvector:pg17
    container_name: codeatlas-db
    environment:
      POSTGRES_DB: codeatlas_db
      POSTGRES_USER: codeatlas
      POSTGRES_PASSWORD: codeatlas
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  app:
    build: .
    container_name: codeatlas-app
    env_file:
      - .env
    ports:
      - "5000:5000"
    depends_on:
      - db

  frontend:
    build:
      context: ./frontend
    container_name: codeatlas-frontend
    ports:
      - "3000:3000"
    depends_on:
      - app

volumes:
  postgres_data:
